# Copie para .env e ajuste. Nunca versione o arquivo .env.
APP_ENV=development
LOG_LEVEL=INFO

DATABASE_URL=postgresql+psycopg://jobpilot:jobpilot@localhost:5432/jobpilot
REDIS_URL=redis://localhost:6379/0

# Gere um valor próprio: python -c "import secrets; print(secrets.token_urlsafe(48))"
# A aplicação recusa iniciar enquanto este valor começar com "change-me".
JWT_SECRET_KEY=change-me-gere-um-segredo-com-pelo-menos-32-caracteres
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60

STORAGE_DIR=./storage
MAX_RESUME_SIZE_MB=5

# Lista JSON de origens permitidas para o futuro dashboard, ex.: ["http://localhost:3000"]
CORS_ORIGINS=[]

# Usado apenas pelos testes automatizados.
TEST_DATABASE_URL=postgresql+psycopg://jobpilot:jobpilot@localhost:5432/jobpilot_test

# Provedor de vagas simulado (dados fictícios). Desabilite em produção.
ENABLE_SIMULATED_PROVIDERS=true

# Provedor de IA: "simulated" (sem custo, regras por palavras-chave) ou "openai".
AI_PROVIDER=simulated
# Necessária apenas com AI_PROVIDER=openai. Nunca versione a chave real.
OPENAI_API_KEY=
# Confira os modelos disponíveis na sua conta OpenAI antes de alterar.
OPENAI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=60

# Worker de automações (python -m app.worker)
WORKER_TICK_SECONDS=30
WORKER_LEASE_SECONDS=900
WORKER_MAX_JOBS_PER_TICK=5
STALE_SUBMISSION_MINUTES=15

# Chave Fernet para cifrar tokens OAuth e segredos de webhook (obrigatória para
# conectar e-mails). Gere com:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# OAuth de e-mail (opcional). Registre a URL de retorno:
# {OAUTH_REDIRECT_BASE_URL}/api/v1/integrations/{gmail|outlook}/callback
OAUTH_REDIRECT_BASE_URL=http://localhost:8000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
EMAIL_SYNC_LOOKBACK_DAYS=14

# Canais de notificação (opcionais)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
TELEGRAM_BOT_TOKEN=
